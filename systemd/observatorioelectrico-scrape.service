[Unit]
Description=observatorio_electrico -- scraper de panelexpertos.cl (año en curso)

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/observatorio_electrico
ExecStart=/home/ubuntu/observatorio_electrico/.venv/bin/python -m adquisicion.scraper_panel
Environment=TZ=America/Santiago
Environment=PYTHONUNBUFFERED=1
MemoryAccounting=true
MemoryMax=400M
